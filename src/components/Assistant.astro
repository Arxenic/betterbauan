---
import BauanMark from './BauanMark.astro';

const suggestions = [
  'Sino ang mayor ng Bauan?',
  'What is the SK gap?',
  'Why are 17 contracts not on the map?',
  'What is Sublian?',
  'How many people live in Bauan?',
  'How can I help verify the record?',
];
---

<div class="assistant" data-assistant>
  <button
    type="button"
    class="assistant-hint"
    data-assistant-open
    data-assistant-hint
    aria-controls="assistant-panel"
    aria-expanded="false"
  >
    Ask BetterBauan <span aria-hidden="true">→</span>
  </button>

  <button
    type="button"
    class="assistant-launcher"
    data-assistant-open
    aria-controls="assistant-panel"
    aria-expanded="false"
    aria-label="Open the BetterBauan assistant"
  >
    <span class="assistant-bot" data-bot-canvas aria-hidden="true"></span>
    <span class="assistant-bot-fallback" data-bot-fallback aria-hidden="true">
      <svg viewBox="0 0 120 120" role="presentation">
        <defs>
          <linearGradient id="mascot-face" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd15c" />
            <stop offset="1" stop-color="#e8a317" />
          </linearGradient>
        </defs>
        <circle cx="60" cy="60" r="54" fill="#e9f7ee" />
        <g fill="#2e7d46">
          <path d="M38 28c-5-8-4-14-1-17 4 3 6 9 4 16Z" />
          <path d="M60 23c0-8 4-13 8-14 2 5 0 11-5 16Z" />
          <path d="M82 28c5-8 4-14 1-17-4 3-6 9-4 16Z" />
          <path d="M24 49c-8-3-12-9-12-14 6-1 11 3 14 10Z" />
          <path d="M96 49c8-3 12-9 12-14-6-1-11 3-14 10Z" />
        </g>
        <circle cx="60" cy="53" r="27" fill="url(#mascot-face)" />
        <ellipse cx="50" cy="51" rx="3.4" ry="4.4" fill="#123a2b" />
        <ellipse cx="70" cy="51" rx="3.4" ry="4.4" fill="#123a2b" />
        <circle cx="48.8" cy="49.4" r="1.1" fill="#ffffff" />
        <circle cx="68.8" cy="49.4" r="1.1" fill="#ffffff" />
        <path d="M53 62c2.1 2.6 4.4 3.8 7 3.8s4.9-1.2 7-3.8" fill="none" stroke="#123a2b" stroke-width="2" stroke-linecap="round" />
        <ellipse cx="42" cy="59" rx="4.2" ry="2.5" fill="#ef6b4f" opacity="0.7" />
        <ellipse cx="78" cy="59" rx="4.2" ry="2.5" fill="#ef6b4f" opacity="0.7" />
        <path d="M44 85h32l7 18H37Z" fill="#fffbf1" stroke="#cfe6d6" stroke-width="1.4" />
        <path d="M49 82h22" stroke="#2e7d46" stroke-width="4" stroke-linecap="round" />
        <circle cx="60" cy="94" r="6.4" fill="#0e6b48" stroke="#f0b52f" stroke-width="2" />
        <path d="M46 104h28" stroke="#ef6b4f" stroke-width="2.2" stroke-linecap="round" />
        <path d="M34 110c4-2.4 8-2.4 12 0s8 2.4 12 0 8-2.4 12 0 8 2.4 12 0" fill="none" stroke="#2a9bc4" stroke-width="2.4" stroke-linecap="round" />
      </svg>
    </span>
    <span class="assistant-status-dot" aria-hidden="true"></span>
  </button>

  <div class="assistant-backdrop" data-assistant-backdrop hidden></div>

  <section
    id="assistant-panel"
    class="assistant-panel"
    data-assistant-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="assistant-title"
    hidden
  >
    <header class="assistant-head">
      <div class="assistant-id">
        <span class="assistant-mark" aria-hidden="true"><BauanMark class="size-6" /></span>
        <div>
          <p id="assistant-title" class="assistant-title">Ask BetterBauan</p>
          <p class="assistant-subtitle"><span class="assistant-online" aria-hidden="true"></span> Open record · NYO</p>
        </div>
      </div>
      <div class="assistant-head-actions">
        <button
          type="button"
          class="assistant-icon-btn"
          data-assistant-voice
          aria-pressed="false"
          aria-label="Read replies aloud"
          title="Read replies aloud"
        >
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 8v4h3l4 3V5L7 8H4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
            <path d="M14 7.5a4 4 0 0 1 0 5M16.5 5a7 7 0 0 1 0 10" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        </button>
        <button type="button" class="assistant-icon-btn" data-assistant-close aria-label="Close the assistant">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </header>

    <div class="assistant-body">
      <div class="assistant-welcome" data-assistant-welcome>
        <p class="assistant-kicker">The independent Bauan record</p>
        <h2 class="assistant-question">What would you like to know about Bauan?</h2>
        <p class="assistant-intro">
          Ask about the mayor and council, the forty barangays, the map, contracts, finances, culture
          or the gaps still missing from the public record.
        </p>

        <div class="assistant-chips" data-assistant-chips>
          {
            suggestions.map((suggestion) => (
              <button type="button" class="assistant-chip" data-assistant-prompt={suggestion}>
                {suggestion}
              </button>
            ))
          }
        </div>

        <p class="assistant-scope">
          Answers only from this site. English · Filipino · Taglish.
        </p>
      </div>

      <div class="assistant-messages" data-assistant-messages aria-live="polite"></div>
    </div>

    <form class="assistant-composer" data-assistant-form>
      <label class="sr-only" for="assistant-input">Ask about Bauan</label>
      <div class="assistant-field">
        <textarea
          id="assistant-input"
          data-assistant-input
          rows="1"
          maxlength="1200"
          placeholder="Ask about Bauan…"
          autocomplete="off"
        ></textarea>
        <div class="assistant-tools">
          <label class="assistant-lang">
            <span class="sr-only">Voice input language</span>
            <select data-assistant-lang aria-label="Voice input language">
              <option value="en-PH">EN</option>
              <option value="fil-PH">FIL</option>
            </select>
          </label>
          <button
            type="button"
            class="assistant-icon-btn"
            data-assistant-mic
            aria-pressed="false"
            aria-label="Ask by voice"
            title="Ask by voice"
          >
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <rect x="7.2" y="2.6" width="5.6" height="10" rx="2.8" stroke="currentColor" stroke-width="1.4" />
              <path d="M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v2.5M7.5 17.5h5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          </button>
          <button type="submit" class="assistant-send" data-assistant-send aria-label="Send question">
            <span class="sr-only" data-assistant-send-label>Send</span>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="m3.5 10 12-6-4.2 12-2.2-4.6L3.5 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
      <p class="assistant-status" data-assistant-status aria-live="polite"></p>
    </form>

    <p class="assistant-disclaimer">
      Messages are sent to NYO to be answered; voice uses your browser's speech service. This site
      stores no chat, account or audio. Not the municipality; for official transactions, use the LGU.
      <a href="/about"> How the assistant works</a>
    </p>
  </section>
</div>

<script>
  import { initAssistant } from '../lib/assistant';

  initAssistant();

  const startMascot = async () => {
    const { initMascot } = await import('../lib/mascot3d');
    await initMascot();
  };

  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(() => void startMascot(), { timeout: 1800 });
  } else {
    setTimeout(() => void startMascot(), 900);
  }
</script>
