---
interface Props {
  class?: string;
}

// A compact stand-in for the municipal emblem: sun, ridge, hall, sea.
// Deliberately geometric, so it holds up at 20 px and at 200 px.
const { class: className = 'size-9' } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  class={className}
  role="img"
  aria-label="Bauan emblem: a sun over a mountain ridge and the sea"
  fill="none"
>
  <circle cx="24" cy="24" r="22.5" stroke="currentColor" stroke-opacity="0.35" />
  <circle cx="31" cy="13.5" r="4.6" fill="var(--color-gold)" />
  <g stroke="var(--color-gold)" stroke-width="1.6" stroke-linecap="round">
    <path d="M31 5.5v2" />
    <path d="M38.2 8.2l-1.4 1.4" />
    <path d="M41 15.4h-2" />
    <path d="M37.6 21.9l-1.4-1.4" />
  </g>
  <path d="M5.5 30.5 17 17l6 7 4.6-5.4L42 30.5Z" fill="var(--color-brand)" />
  <path d="M5.5 30.5h36.5v3.2H5.5Z" fill="var(--color-brand-deep)" opacity="0.9" />
  <path d="M12 31V24h9v7Z" fill="var(--color-paper)" />
  <path d="M14 24.5h5v3h-5Z" fill="var(--color-brand-deep)" />
  <path d="M27 31v-6h8v6Z" fill="var(--color-paper)" opacity="0.92" />
  <path
    d="M4.5 36.2c3.2-2.2 6.4-2.2 9.6 0s6.4 2.2 9.6 0 6.4-2.2 9.6 0 6.4 2.2 9.6 0"
    stroke="var(--color-sea)"
    stroke-width="2.2"
    stroke-linecap="round"
  />
  <path
    d="M9 41c2.6-1.8 5.2-1.8 7.8 0s5.2 1.8 7.8 0 5.2-1.8 7.8 0 5.2 1.8 7.8 0"
    stroke="var(--color-sea)"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-opacity="0.7"
  />
</svg>
