---
interface Props {
  class?: string;
  alt?: string;
}

const {
  class: className = 'size-9',
  alt = 'Official seal of the Sangguniang Bayan of Bauan, Batangas',
} = Astro.props;
---

<img
  src="/assets/bauan-seal.png"
  alt={alt}
  width="512"
  height="512"
  decoding="async"
  class={`bauan-seal ${className}`}
/>
