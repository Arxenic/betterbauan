---
/**
 * Vertical column chart for short series such as years. Server-rendered SVG-free
 * CSS columns, with every value also present as text.
 */
import { num, peso, pesoCompact, pesoShort } from '../lib/format';

interface Row {
  label: string;
  value: number;
  note?: string;
}

interface Props {
  title: string;
  subtitle?: string;
  rows: Row[];
  format?: 'number' | 'peso' | 'pesoShort' | 'pesoCompact';
  note?: string;
  id?: string;
}

const { title, subtitle, rows, format = 'number', note, id } = Astro.props;

const formatters = { number: num, peso, pesoShort, pesoCompact } as const;
const fmt = formatters[format];
const max = Math.max(...rows.map((row) => row.value), 1);
---

<figure class="chart" id={id}>
  <figcaption class="chart-caption">
    <span class="chart-title">{title}</span>
    {subtitle && <span class="chart-subtitle">{subtitle}</span>}
  </figcaption>

  <div class="chart-scroll">
    <div class="chart-columns">
      {
        rows.map((row, index) => (
          <div class="chart-column">
            <span class="chart-column-value">{fmt(row.value)}</span>
            <span class="chart-column-track">
              <span
                class="chart-column-fill"
                style={`height:${Math.max(1.5, (row.value / max) * 100).toFixed(2)}%;animation-delay:${index * 55}ms`}
                title={`${row.label}: ${fmt(row.value)}`}
              />
            </span>
            <span class="chart-column-label">{row.label}</span>
          </div>
        ))
      }
    </div>
  </div>

  {note && <p class="chart-note">{note}</p>}
</figure>
