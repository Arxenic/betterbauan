---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  id?: string;
}

const { eyebrow, title, lede, id } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="mt-2 font-display text-[1.6rem] leading-tight tracking-tight sm:text-[1.9rem]">
    {title}
  </h2>
  {lede && <p class="lede mt-3">{lede}</p>}
</div>
