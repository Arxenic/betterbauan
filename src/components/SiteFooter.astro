---
import { NAV, SITE } from '../data/site';
import { isoDate } from '../lib/format';
import dpwh from '../data/generated/dpwh.json';
import fdp from '../data/generated/fdp.json';
import psa from '../data/generated/psa.json';

const refreshed = [psa.retrievedAt, dpwh.retrievedAt, fdp.retrievedAt].sort().at(-1) ?? null;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="wrap grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr]">
    <div>
      <p class="font-display text-lg tracking-tight">
        {SITE.wordmarkFirst}<span class="text-brand">{SITE.wordmarkSecond}</span>
      </p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-soft">
        An independent, volunteer-run project. Not affiliated with, endorsed by, or operated by the
        Municipality of Bauan or any government agency.
      </p>
      <p class="mt-4 text-sm text-muted">
        Part of the{' '}
        <a href={SITE.directory} class="text-brand underline decoration-brand/30 underline-offset-2" rel="noopener">
          Better LGU directory
        </a>.
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-muted">Explore</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-ink-soft no-underline hover:text-brand">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/sources" class="text-ink-soft no-underline hover:text-brand">Sources</a>
        </li>
      </ul>
    </nav>

    <div>
      <h2 class="text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-muted">Data</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-soft">
        <li>
          Last refreshed
          <span class="block text-ink">{isoDate(refreshed)}</span>
        </li>
        <li>
          <a href="/about#verification" class="text-brand underline decoration-brand/30 underline-offset-2">
            How figures are verified
          </a>
        </li>
        <li>
          <a href={SITE.issues} class="text-brand underline decoration-brand/30 underline-offset-2" rel="noopener">
            Report a correction
          </a>
        </li>
        <li>
          <a href={SITE.repo} class="text-brand underline decoration-brand/30 underline-offset-2" rel="noopener">
            Source code
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-2 py-5 text-[0.78rem] text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} BetterBauan contributors. Code MIT · content CC BY 4.0.</p>
      <p>Built from public records. No personal data collected.</p>
    </div>
  </div>
</footer>
