---
import { NAV, SITE } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;
---

<header class="border-b border-line bg-paper">
  <div class="wrap flex items-center justify-between gap-6 py-4">
    <a href="/" class="group flex items-baseline gap-2 no-underline">
      <span class="font-display text-[1.35rem] leading-none tracking-tight text-ink">
        {SITE.wordmarkFirst}<span class="text-brand">{SITE.wordmarkSecond}</span>
      </span>
      <span class="hidden text-[0.7rem] uppercase tracking-[0.14em] text-muted sm:inline">
        {SITE.province}
      </span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-5 text-[0.9rem]">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'no-underline transition-colors hover:text-brand',
                  isActive(item.href)
                    ? 'font-semibold text-brand underline decoration-brand/40 decoration-2 underline-offset-[6px]'
                    : 'text-ink-soft',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={SITE.repo}
            class="inline-flex items-center gap-1.5 rounded-sm border border-line-strong px-2.5 py-1 text-[0.8rem] text-ink-soft no-underline transition-colors hover:border-brand hover:text-brand"
            rel="noopener"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" class="size-3.5 fill-current">
              <path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.055-.49.055-.49.8.06 1.23.83 1.23.83.72 1.23 1.88.87 2.34.67.073-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            Source
          </a>
        </li>
      </ul>
    </nav>

    <span class="rounded-full border border-line-strong px-2.5 py-1 text-[0.68rem] uppercase tracking-[0.1em] text-muted md:hidden">
      Independent
    </span>
  </div>

  <nav aria-label="Primary, compact" class="border-t border-line md:hidden">
    <ul class="no-scrollbar wrap flex gap-5 overflow-x-auto py-2.5 text-[0.85rem]">
      {
        NAV.map((item) => (
          <li class="shrink-0">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'no-underline',
                isActive(item.href) ? 'font-semibold text-brand' : 'text-ink-soft',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="shrink-0">
        <a href={SITE.repo} class="text-ink-soft no-underline" rel="noopener">Source</a>
      </li>
    </ul>
  </nav>
</header>
