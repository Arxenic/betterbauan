---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page does not exist on BetterBauan.">
  <section class="wrap py-24 text-center sm:py-32">
    <p class="eyebrow">404</p>
    <h1 class="mx-auto mt-3 max-w-xl font-display text-[2.2rem] leading-tight tracking-tight sm:text-[2.8rem]">
      That record <span class="text-brand">isn't here.</span>
    </h1>
    <p class="lede mx-auto mt-4 max-w-md">
      The page may have moved, or it may never have existed. The datasets are all reachable from the
      homepage.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn btn-primary">Back to the homepage</a>
      <a href="/sources" class="btn btn-secondary">Browse sources</a>
    </div>
  </section>
</Base>
