---
import Base from '../layouts/Base.astro';
import BauanMark from '../components/BauanMark.astro';
import EvidenceNote from '../components/EvidenceNote.astro';
import Callout from '../components/Callout.astro';
import dpwh from '../data/generated/dpwh.json';
import fdp from '../data/generated/fdp.json';
import map from '../data/generated/map.json';
import psa from '../data/generated/psa.json';
import { MAYOR } from '../data/officials';
import { SITE } from '../data/site';
import { isoDate, num, pesoCompact, pesoShort } from '../lib/format';

const m = psa.municipality;
const bauan = map.levels.bauan;
const completed = dpwh.summary.byStatus.Completed ?? 0;
const refreshed = [psa.retrievedAt, dpwh.retrievedAt, fdp.retrievedAt, map.source.retrievedAt].sort().at(-1) ?? '';

const largest = [...bauan.barangays].sort((a, b) => b.population - a.population)[0];
const byContract = [...bauan.barangays]
  .sort((a, b) => b.contractAmount - a.contractAmount)
  .slice(0, 5);
const maxContract = byContract[0]?.contractAmount ?? 1;

const contents = [
  {
    href: '/map',
    n: '01',
    title: 'The town, in three scales',
    desc: 'From the archipelago to Batangas to forty barangays, each grown to its own statistic.',
  },
  {
    href: '/barangays',
    n: '02',
    title: 'Where everyone lives',
    desc: 'Population and households for all forty barangays, reconciled to the municipal total.',
  },
  {
    href: '/finances',
    n: '03',
    title: 'The money, filed',
    desc: `${num(fdp.summary.count)} statutory filings, posted by the LGU itself and indexed here.`,
  },
  {
    href: '/projects',
    n: '04',
    title: 'What was built',
    desc: `${num(dpwh.summary.count)} national infrastructure contracts, ${pesoShort(dpwh.summary.totalBudget)} in all.`,
  },
  {
    href: '/documents',
    n: '05',
    title: 'The paper trail',
    desc: 'The full disclosure archive, searchable by form and period, linked to the originals.',
  },
  {
    href: '/government',
    n: '06',
    title: 'Who governs',
    desc: `Mayor ${MAYOR.name}, the 2025–2028 council, and the mayors who came before.`,
  },
  {
    href: '/culture',
    n: '07',
    title: 'Sublian, and the town that moved',
    desc: 'The Holy Cross, the feast on 3 May, and the three relocations that brought the town to this shore.',
  },
];
---

<Base>
  <!-- Cover ------------------------------------------------------- -->
  <section class="cover">
    <div class="wrap cover-grid">
      <div class="relative z-10">
        <p class="kicker">Bauan, Batangas · independent public record</p>

        <h1 class="cover-title mt-5">
          We are<br />
          <span class="outline">One</span><br />
          in Bauan.
        </h1>

        <p class="standfirst mt-6 max-w-md">
          The town's population, barangays, budget, contracts and culture — assembled from the agencies
          that publish them, and dated so you can tell how fresh each one is.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a href="#contents" class="btn btn-primary">Read the record</a>
          <a href="/map" class="btn btn-secondary">Open the 3D map</a>
        </div>

        <dl class="cover-lines mt-9 max-w-xl">
          <div class="cover-line">
            <dt>Population</dt>
            <dd class="tnum" data-count={String(m.population)}>{num(m.population)}</dd>
          </div>
          <div class="cover-line">
            <dt>Barangays</dt>
            <dd class="tnum">Forty</dd>
          </div>
          <div class="cover-line">
            <dt>Contracts mapped</dt>
            <dd class="tnum">{num(bauan.totals.assignedPins)}</dd>
          </div>
        </dl>

        <p class="mt-7 scroll-cue">
          <span aria-hidden="true"></span>
          Scroll to read
        </p>
      </div>

      <div class="relative mt-2" data-parallax="-0.035">
        <div
          class="emblem-stage"
          data-emblem
          role="img"
          aria-label="The Bauan municipal emblem in three dimensions: a golden sun over two green ridges, the white municipal hall, a palm and three bands of sea."
        >
          <div class="emblem-ring" aria-hidden="true"></div>
          <div class="emblem-ring emblem-ring-2" aria-hidden="true"></div>
          <div class="emblem-glow" aria-hidden="true"></div>
          <div data-emblem-fallback hidden class="absolute inset-0 grid place-content-center">
            <BauanMark class="size-52 text-ink" />
          </div>
          <noscript>
            <div class="absolute inset-0 grid place-content-center">
              <BauanMark class="size-52 text-ink" />
            </div>
          </noscript>
          <p class="emblem-caption">
            The municipal mark, rebuilt in three dimensions. Drag across it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee ----------------------------------------------------- -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      {
        [0, 1].map(() => (
          <div class="marquee-seq">
            <span>{num(m.population)} residents</span>
            <i />
            <span>40 barangays</span>
            <i />
            <span>{pesoShort(dpwh.summary.totalBudget)} in contracts</span>
            <i />
            <span>{num(fdp.summary.count)} filings</span>
            <i />
            <span>Sublian · 3 May</span>
            <i />
            <span>Parish 1596 · town 1690</span>
            <i />
            <span>We are One in Bauan</span>
            <i />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Contents ---------------------------------------------------- -->
  <section id="contents" class="wrap py-14 sm:py-20">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div data-reveal>
        <p class="kicker">Contents</p>
        <h2 class="display-xl mt-4">Seven ways<br />into the record.</h2>
        <p class="standfirst mt-5 max-w-sm">
          Every page is built from a committed dataset. Re-run the scripts and you should get the same
          bytes.
        </p>
        <p class="mt-6 max-w-sm text-[0.8rem] leading-relaxed text-muted">
          No account, no tracking, no opinion. Just the record, with a link to check it yourself.
        </p>
      </div>

      <ol class="toc" data-reveal style="--reveal-delay:120ms">
        {
          contents.map((item) => (
            <li>
              <a href={item.href} class="toc-item">
                <span class="toc-num">{item.n}</span>
                <span class="toc-title">{item.title}</span>
                <span class="toc-desc">{item.desc}</span>
                <span class="toc-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Feature: the map -------------------------------------------- -->
  <section class="border-y border-line bg-surface-soft">
    <div class="wrap grid grid-cols-1 gap-10 py-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:py-20">
      <div data-reveal>
        <p class="kicker">Feature · the map</p>
        <h2 class="display-l mt-4">The town, grown<br />to its own numbers.</h2>
        <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-ink-soft">
          Fly from the Philippines to Batangas to Bauan, then read a barangay or a contract where it
          actually sits. On the town level, each of the forty barangays rises to its population,
          households, contract count or contract value.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a href="/map" class="btn btn-primary">Enter the map</a>
          <a href="/barangays" class="btn btn-secondary">Skip to the table</a>
        </div>

        <p class="serif-note mt-6 max-w-md">
          Heights are statistics, not elevation. A true relief model would need a digital elevation
          file, which this project does not ship — so the map does not pretend to show one.
        </p>
      </div>

      <div class="figure" data-reveal style="--reveal-delay:100ms">
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="display-m">Where the contract value sits</h3>
          <span class="folio">Top five barangays</span>
        </div>

        <ul class="chart-rows mt-5">
          {
            byContract.map((barangay) => (
              <li class="chart-row">
                <span class="chart-label">{barangay.name}</span>
                <span class="chart-bar">
                  <span
                    class="chart-fill"
                    style={`width:${Math.max(3, (barangay.contractAmount / maxContract) * 100)}%`}
                  />
                </span>
                <span class="chart-value">{pesoCompact(barangay.contractAmount)}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-6 grid grid-cols-3 gap-4 border-t border-line pt-4">
          <div>
            <p class="folio">Mapped contracts</p>
            <p class="tnum font-display text-xl font-bold">{num(bauan.totals.assignedPins)}</p>
          </div>
          <div>
            <p class="folio">Mapped value</p>
            <p class="tnum font-display text-xl font-bold">{pesoCompact(bauan.totals.contractAmount)}</p>
          </div>
          <div>
            <p class="folio">Barangays with work</p>
            <p class="tnum font-display text-xl font-bold">{num(bauan.totals.barangaysWithContracts)}</p>
          </div>
        </div>

        <p class="figure-caption mt-4">
          DPWH records whose coordinates fall inside a barangay polygon. Five of the 108 contracts
          could not be matched to a polygon and are not drawn.
        </p>
      </div>
    </div>
  </section>

  <!-- Numbers ----------------------------------------------------- -->
  <section class="wrap py-14 sm:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-ink pb-4" data-reveal>
      <h2 class="display-l">The record, in four figures.</h2>
      <span class="folio">PSA 2024 · DPWH · DILG FDP</span>
    </div>

    <dl class="grid grid-cols-2 gap-x-8 gap-y-10 pt-8 lg:grid-cols-4">
      <div data-reveal>
        <dt class="kicker-plain">Residents</dt>
        <dd class="stat-mega mt-2 text-brand" data-count={String(m.population)}>{num(m.population)}</dd>
        <p class="mt-2 text-[0.78rem] leading-relaxed text-muted">2024 census, PSA</p>
      </div>
      <div data-reveal style="--reveal-delay:80ms">
        <dt class="kicker-plain">Households</dt>
        <dd class="stat-mega mt-2" data-count={String(m.households)}>{num(m.households)}</dd>
        <p class="mt-2 text-[0.78rem] leading-relaxed text-muted">2024 census, PSA</p>
      </div>
      <div data-reveal style="--reveal-delay:160ms">
        <dt class="kicker-plain">Infrastructure</dt>
        <dd class="stat-mega mt-2 text-gold" data-count="2.05" data-decimals="2" data-prefix="₱" data-suffix="B">
          ₱2.05B
        </dd>
        <p class="mt-2 text-[0.78rem] leading-relaxed text-muted">
          {num(dpwh.summary.count)} contracts · {num(completed)} completed
        </p>
      </div>
      <div data-reveal style="--reveal-delay:240ms">
        <dt class="kicker-plain">Filings</dt>
        <dd class="stat-mega mt-2" data-count={String(fdp.summary.count)}>{num(fdp.summary.count)}</dd>
        <p class="mt-2 text-[0.78rem] leading-relaxed text-muted">
          CY{fdp.coverage.from}–CY{fdp.coverage.to}, DILG portal
        </p>
      </div>
    </dl>

    <p class="mt-10 max-w-3xl text-[0.82rem] leading-relaxed text-muted">
      Land area is {m.landAreaKm2} km² from PSA, the figure this site publishes; the commonly cited
      53.31 km² is noted on the <a href="/government#profile" class="link-underline">government page</a>.
      The largest barangay is {largest?.name}, with {num(largest?.population ?? 0)} residents.
    </p>
  </section>

  <!-- Culture ---------------------------------------------------- -->
  <section class="border-y border-line">
    <div class="wrap grid grid-cols-1 gap-10 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:py-20">
      <div data-reveal>
        <p class="kicker">Culture · Sublian</p>
        <h2 class="display-l mt-4">The festival is<br />the history.</h2>
        <p class="dropcap mt-5 max-w-xl text-[0.98rem] leading-[1.7] text-ink-soft">
          Bauan's subli is a dance offered to the Mahal na Poong Santa Cruz, the Holy Cross found in
          Alitagtag at the end of the sixteenth century. The town keeps the feast on 3 May; the
          Sublian Festival fills the days before it, with the two sibling crosses meeting at Concordia
          and a procession back through Manghinao.
        </p>
        <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-ink-soft">
          The 25th Sublian Festival was held on 2 May 2026. The town also counts its founding from the
          move to the present site in 1690 — the 336th anniversary fell on 30 January 2026.
        </p>
        <a href="/culture" class="btn btn-secondary mt-7">Read the culture page</a>
      </div>

      <figure class="pullquote self-start" data-reveal style="--reveal-delay:100ms">
        “One Legacy, One Community, One Future, as We are One in Bauan.”
        <cite>336th Founding Anniversary theme, Municipality of Bauan, 2026</cite>
      </figure>
    </div>
  </section>

  <!-- Method ----------------------------------------------------- -->
  <section class="wrap py-14 sm:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-4 border-b border-ink pb-4">
      <h2 class="display-l">Nothing here is guessed.</h2>
      <span class="folio">Three rules</span>
    </div>

    <ol class="mt-8 grid gap-8 sm:grid-cols-3">
      <li data-reveal>
        <p class="stat-mega text-line-strong">01</p>
        <h3 class="mt-1 text-[1rem] font-bold">Every figure has a record</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Each number links to the agency that published it — a PSA table, a DILG filing, a DPWH
          contract — with the date it was read.
        </p>
      </li>
      <li data-reveal style="--reveal-delay:80ms">
        <p class="stat-mega text-line-strong">02</p>
        <h3 class="mt-1 text-[1rem] font-bold">Unverifiable means unpublished</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          If a claim cannot be traced to a primary record, the page says so and stays empty. An honest
          gap beats a wrong number.
        </p>
      </li>
      <li data-reveal style="--reveal-delay:160ms">
        <p class="stat-mega text-line-strong">03</p>
        <h3 class="mt-1 text-[1rem] font-bold">Corrections are public</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          A wrong figure is withdrawn first and re-verified second. Every change is recorded in the
          repository's history.
        </p>
      </li>
    </ol>

    <div class="mt-10 max-w-3xl">
      <EvidenceNote
        sourceId="psa-openstat"
        locator="PO_2024/0041A6DTPH3.px"
        retrievedAt={psa.retrievedAt}
        note={`Population, households and land area come from the PSA table. Barangay figures reconcile to the municipal total exactly. Last data refresh ${isoDate(refreshed)}.`}
      />
    </div>
  </section>

  <!-- Disclaimer ------------------------------------------------- -->
  <section class="wrap pb-16">
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.4fr_1fr]">
      <Callout tone="warn" title="This is not the municipality's website">
        <p>
          BetterBauan is built by volunteers from public records. It is not affiliated with, endorsed
          by, or operated by the Municipality of Bauan. For official transactions, use the LGU's own
          offices.
        </p>
        <p>
          The official domain <span class="font-mono text-[0.8rem]">bauan.gov.ph</span> did not respond
          when checked, which is one reason this project indexes records held by national agencies
          instead.
        </p>
      </Callout>

      <div class="card p-5">
        <h2 class="display-m">Found an error?</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft">
          Corrections are the point, not an embarrassment. Send the source that contradicts us and the
          figure comes down first, then gets re-verified.
        </p>
        <a href={SITE.issues} class="mt-4 inline-block text-sm link-underline" rel="noopener">
          Open an issue on GitHub
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { initEmblem } from '../lib/emblem3d';
  initEmblem();
</script>
